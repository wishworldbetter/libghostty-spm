+    // DECSTBM rows 2-4 (1-based); destroying row 1 leaves no
+    // representable remainder for the straddling selection.
+    t.setTopAndBottomMargin(2, 4);
+    t.setCursorPos(2, 1);
+    t.deleteLines(1);
+
+    try testing.expect(screen.selection == null);
+}
