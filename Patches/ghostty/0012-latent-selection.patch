diff --git a/src/terminal/stream_terminal.zig b/src/terminal/stream_terminal.zig
index c635e91..f0bade3 100644
--- a/src/terminal/stream_terminal.zig
+++ b/src/terminal/stream_terminal.zig
@@ -533,6 +533,11 @@ pub const Handler = struct {
 
             .origin => self.terminal.setCursorPos(1, 1),
 
+            // tmux-style repaints are bracketed by hide/show cursor;
+            // the latent selection machinery keys off these frame
+            // boundaries (no-op when no selection state exists).
+            .cursor_visible => self.terminal.cursorVisibilityChanged(enabled),
+
             .enable_left_and_right_margin => if (!enabled) {
                 self.terminal.scrolling_region.left = 0;
                 self.terminal.scrolling_region.right = self.terminal.cols - 1;
@@ -2423,3 +2428,151 @@ test "kitty graphics via APC" {
     const img = storage.imageById(1).?;
     try testing.expectEqual(.rgb, img.format);
 }
+
+// The following two tests replay REAL captured tmux byte streams. They were
+// recorded from tmux 3.6a driven exactly the way Seedmux's wheel bridge
+// drives it (private conf replica; `copy-mode -e` + `send-keys -X -N <n>
+// scroll-up/scroll-down` bursts against an 80x24 client, TERM=xterm-256color)
+// with the client pty output captured verbatim. See res/tmux_wheel_*.raw.
+//
+// Key empirical facts these streams encode, which hand-written IL/DL
+// sequences do not reproduce:
+//   - copy-mode entry repaints the whole screen in place (CUP home + rows
+//     separated by CR/LF + EL), moving content with NO IL/DL at all;
+//   - a fast flick coalesces in tmux: 245 scrolled lines produced only
+//     120 IL on the way out and 60 DL plus one final full repaint on the
+//     way back, so most of the motion is invisible to the IL/DL ledger;
+//   - every repaint cycle hides the cursor first (DECRST 25) and shows it
+//     again (DECSET 25) only after the last cell of the frame is painted -
+//     and after the final frame NOTHING else follows, so DECSET 25 is the
+//     only trigger that ever sees the settled screen.
+
+test "Terminal: latent selection revives across real tmux wheel flick" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    // Attach: tmux paints LINE-478..LINE-500 on rows 0..22, prompt on 23.
+    s.nextSlice(@embedFile("res/tmux_wheel_flick_attach.raw"));
+
+    // User selects "LINE-490" (row 12).
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 12 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 7, .y = 12 } }).?,
+        false,
+    ));
+    {
+        const before = try screen.selectionString(alloc, .{
+            .sel = screen.selection.?,
+            .trim = false,
+        });
+        defer alloc.free(before);
+        try testing.expectEqualStrings("LINE-490", before);
+    }
+
+    // The full recorded flick: burst of scroll-ups (245 lines, heavily
+    // coalesced by tmux), then a burst of scroll-downs overshooting the
+    // bottom so copy-mode auto-exits with a final full repaint.
+    s.nextSlice(@embedFile("res/tmux_wheel_flick_scroll.raw"));
+
+    // The highlight must be back on the exact text the user selected.
+    const sel = screen.selection orelse return error.TestExpectedRestore;
+    const after = try screen.selectionString(alloc, .{
+        .sel = sel,
+        .trim = false,
+    });
+    defer alloc.free(after);
+    try testing.expectEqualStrings("LINE-490", after);
+}
+
+test "Terminal: latent selection revives across real tmux slow scroll" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    // Attach: LINE-478..LINE-500 on rows 0..22, prompt on row 23.
+    s.nextSlice(@embedFile("res/tmux_wheel_slow_attach.raw"));
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 12 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 7, .y = 12 } }).?,
+        false,
+    ));
+
+    // Same wheel commands, but paced slowly so tmux drains between
+    // commands: entry full repaint (5 lines, no IL/DL!), then IL walks
+    // out 240 lines, DL walks back, and a final exit repaint.
+    s.nextSlice(@embedFile("res/tmux_wheel_slow_scroll.raw"));
+
+    const sel = screen.selection orelse return error.TestExpectedRestore;
+    const after = try screen.selectionString(alloc, .{
+        .sel = sel,
+        .trim = false,
+    });
+    defer alloc.free(after);
+    try testing.expectEqualStrings("LINE-490", after);
+}
+
+test "Terminal: latent selection sticks to its copy among identical blocks" {
+    // Real capture: the pane shows two byte-identical 9-row blocks (two
+    // `cat` runs of the same file, identical prompt/command lines between
+    // them - the `ll`-twice scenario), 10 rows apart. The user selects
+    // "DUP-05" in the SECOND block (row 18; the first block's identical
+    // copy sits on row 8), wheels out ~66 lines and back with the exact
+    // Seedmux commands, slow-paced.
+    //
+    // On the way back the FIRST block's copy scrolls into view before the
+    // second one. The highlight must NOT revive on it: it must come back
+    // on the original copy, at the original row.
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    s.nextSlice(@embedFile("res/tmux_wheel_dup_attach.raw"));
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 18 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 5, .y = 18 } }).?,
+        false,
+    ));
+    {
+        const before = try screen.selectionString(alloc, .{
+            .sel = screen.selection.?,
+            .trim = false,
+        });
+        defer alloc.free(before);
+        try testing.expectEqualStrings("DUP-05", before);
+    }
+
+    s.nextSlice(@embedFile("res/tmux_wheel_dup_scroll.raw"));
+
+    const sel = screen.selection orelse return error.TestExpectedRestore;
+    const after = try screen.selectionString(alloc, .{
+        .sel = sel,
+        .trim = false,
+    });
+    defer alloc.free(after);
+    try testing.expectEqualStrings("DUP-05", after);
+
+    // The decisive assertion: the ORIGINAL copy (row 18), not the first
+    // block's identical copy on row 8.
+    const pt = screen.pages.pointFromPin(.active, sel.start()) orelse
+        return error.TestExpectedActivePin;
+    try testing.expectEqual(@as(u32, 18), pt.coord().y);
+    try testing.expect(pt.coord().x == 0);
+}
