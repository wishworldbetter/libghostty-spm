+test "Terminal: insertLines translates selection within scroll region" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    for ("ABCDE", 0..) |c, i| {
+        t.setCursorPos(i + 1, 1);
+        try t.printString(&.{ c, c, c });
+    }
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 2 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 2 } }).?,
+        false,
+    ));
+
+    // DECSTBM rows 2-4 (1-based), cursor at region top: tmux copy-mode shape.
+    t.setTopAndBottomMargin(2, 4);
+    t.setCursorPos(2, 1);
+    t.insertLines(1);
+
+    const sel = screen.selection.?;
+    try testing.expectEqual(
+        point.Point{ .active = .{ .x = 0, .y = 3 } },
+        screen.pages.pointFromPin(.active, sel.start()).?,
+    );
+    const str = try screen.selectionString(alloc, .{ .sel = sel });
+    defer alloc.free(str);
+    try testing.expectEqualStrings("CCC", str);
+}
