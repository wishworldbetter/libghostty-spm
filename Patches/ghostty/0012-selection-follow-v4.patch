+/// Recompute the content fingerprint the selection is expected to keep
+/// covering. Called after any deliberate selection mutation: creation
+/// (`select`), and in-place region scroll translation/clipping (which
+/// legitimately changes the covered text when an edge row is clipped).
+///
+/// On allocation failure the fingerprint is dropped, which disables the
+/// content check until the next mutation - fail open, so a valid
+/// selection is never cleared spuriously.
+pub fn rehashSelection(self: *Screen) void {
+    self.selection_text_hash = null;
+    const sel = self.selection orelse return;
+    // Only fingerprint selections fully inside the active area: that is
+    // where in-place repaints strike (the tmux/alt-screen case), and it
+    // bounds the cost - a select-all spanning a large scrollback would
+    // otherwise hash megabytes on every mouse-drag tick.
+    if (self.pages.pointFromPin(.active, sel.start()) == null or
+        self.pages.pointFromPin(.active, sel.end()) == null) return;
+    const str = self.selectionString(self.alloc, .{
+        .sel = sel,
+        .trim = false,
+    }) catch return;
+    defer self.alloc.free(str);
+    self.selection_text_hash = std.hash.Wyhash.hash(0, str);
+}
+
+/// Verify the selection still covers the text it covered when it was
+/// created or last translated, and drop it when the content underneath
+/// changed: an untracked in-place repaint (tmux copy-mode entry/exit,
+/// large coalesced scroll jumps, a TUI rewriting rows) moved or replaced
+/// the content, and a highlight must never sit on text the user didn't
+/// select.
+///
+/// tmux-style repaints are bracketed by hide/show cursor (DECRST/DECSET
+/// 25), with the show arriving only after the last cell of a frame is
+/// painted - stream handlers call this at that frame boundary. No-op
+/// without a selection or fingerprint.
+pub fn selectionContentCheck(self: *Screen) void {
+    const expect = self.selection_text_hash orelse return;
+    const sel = self.selection orelse return;
+    const str = self.selectionString(self.alloc, .{
+        .sel = sel,
+        .trim = false,
+    }) catch {
+        // Can't verify: better no highlight than possibly a wrong one.
+        self.clearSelection();
+        return;
+    };
+    defer self.alloc.free(str);
+    if (std.hash.Wyhash.hash(0, str) != expect) self.clearSelection();
 }
 
