diff --git a/src/terminal/stream_terminal.zig b/src/terminal/stream_terminal.zig
index c635e91..74ca952 100644
--- a/src/terminal/stream_terminal.zig
+++ b/src/terminal/stream_terminal.zig
@@ -533,6 +533,13 @@ pub const Handler = struct {
 
             .origin => self.terminal.setCursorPos(1, 1),
 
+            // tmux-style repaints are bracketed by hide/show cursor, with
+            // the show arriving only after the last cell of a frame is
+            // painted. At that frame boundary, verify the selection still
+            // covers its original text (no-op without a selection).
+            .cursor_visible => if (enabled)
+                self.terminal.screens.active.selectionContentCheck(),
+
             .enable_left_and_right_margin => if (!enabled) {
                 self.terminal.scrolling_region.left = 0;
                 self.terminal.scrolling_region.right = self.terminal.cols - 1;
@@ -2423,3 +2430,258 @@ test "kitty graphics via APC" {
     const img = storage.imageById(1).?;
     try testing.expectEqual(.rgb, img.format);
 }
+
+test "modes: cursor show verifies selection content at frame boundary" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 10, .rows = 5 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    s.nextSlice("AAA\r\nBBB\r\nCCC");
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 1 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 1 } }).?,
+        false,
+    ));
+
+    // Identical in-place repaint frame (tmux copy-mode entry shape):
+    // hide cursor, repaint the same rows, show cursor. Selection stays.
+    s.nextSlice("\x1b[?25l\x1b[HAAA\x1b[K\r\nBBB\x1b[K\r\nCCC\x1b[K\x1b[?25h");
+    try testing.expect(screen.selection != null);
+
+    // In-place repaint that moved content one row up with no IL/DL (a
+    // coalesced scroll jump): at the frame boundary the highlight would
+    // sit on the wrong text, so it must drop.
+    s.nextSlice("\x1b[?25l\x1b[HBBB\x1b[K\r\nCCC\x1b[K\r\nDDD\x1b[K\x1b[?25h");
+    try testing.expect(screen.selection == null);
+}
+
+// The following tests replay REAL captured tmux byte streams (tmux 3.6a,
+// 80x24 client, TERM=xterm-256color, Seedmux private conf replica; client
+// pty output captured verbatim - see res/tmux_wheel_*.raw).
+//
+// The v4 selection contract they pin down:
+//   - while any part of the selection is on screen, the highlight covers a
+//     contiguous run of the originally selected lines - never other text;
+//   - at a screen edge it shrinks row by row (clip), not all at once;
+//   - once fully off screen it clears, and scrolling back does NOT revive
+//     it kernel-side: revival from the multiplexer's true scroll position
+//     is the host's job.
+//
+// tmux repaint frames are bracketed by hide/show cursor and the show
+// (DECSET 25) arrives only after the last cell of the frame, so streams
+// are fed frame by frame split on that marker and every assertion runs at
+// a frame boundary - exactly the moments a user can see or copy.
+
+/// Feed `bytes` frame by frame; after each frame assert the selection (if
+/// any) covers a contiguous run of `original` lines. Returns whether some
+/// frame showed a proper partial run (the clip path really ran).
+fn replayExpectContiguousRuns(
+    s: *Stream,
+    t: *Terminal,
+    bytes: []const u8,
+    original: []const []const u8,
+) !bool {
+    const alloc = testing.allocator;
+    const full = try std.mem.join(alloc, "\n", original);
+    defer alloc.free(full);
+
+    var saw_partial = false;
+    var rest = bytes;
+    const marker = "\x1b[?25h";
+    while (rest.len > 0) {
+        const end = if (std.mem.indexOf(u8, rest, marker)) |idx|
+            idx + marker.len
+        else
+            rest.len;
+        s.nextSlice(rest[0..end]);
+        rest = rest[end..];
+
+        const screen = t.screens.active;
+        const sel = screen.selection orelse continue;
+        const str = try screen.selectionString(alloc, .{ .sel = sel });
+        defer alloc.free(str);
+
+        var matched = false;
+        for (0..original.len) |i| {
+            for (i..original.len) |j| {
+                const run = try std.mem.join(alloc, "\n", original[i .. j + 1]);
+                defer alloc.free(run);
+                if (std.mem.eql(u8, str, run)) matched = true;
+            }
+        }
+        if (!matched) {
+            std.debug.print(
+                "selection on unexpected text at frame boundary: '{s}'\n",
+                .{str},
+            );
+            return error.SelectionOnWrongText;
+        }
+        if (!std.mem.eql(u8, str, full)) saw_partial = true;
+    }
+    return saw_partial;
+}
+
+test "Terminal: real tmux split-entry scroll-up follows, clips at bottom, clears" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    // Attach: LINE-478..LINE-500 on rows 0..22, blank row 23.
+    s.nextSlice(@embedFile("res/tmux_wheel_split_attach.raw"));
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 8 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 7, .y = 10 } }).?,
+        false,
+    ));
+
+    // Only the scroll-up half: copy-mode entry as its own command
+    // (identical-content repaint - the Seedmux bridge splits entry from
+    // the first scroll so the kernel can track every tick), then 30
+    // single-line ILs. The scroll-down half is the next test.
+    const capture: []const u8 = @embedFile("res/tmux_wheel_split_scroll.raw");
+    const first_dl = std.mem.indexOf(u8, capture, "\x1b[1M").?;
+    const up_end = std.mem.lastIndexOf(
+        u8,
+        capture[0..first_dl],
+        "\x1b[?25h",
+    ).? + "\x1b[?25h".len;
+
+    const saw_partial = try replayExpectContiguousRuns(
+        &s,
+        &t,
+        capture[0..up_end],
+        &.{ "LINE-486", "LINE-487", "LINE-488" },
+    );
+
+    // 30 lines up moved the selection out the bottom edge: it must have
+    // shrunk row by row on the way (clip really ran), and be gone now.
+    try testing.expect(saw_partial);
+    try testing.expect(screen.selection == null);
+}
+
+test "Terminal: real tmux split-entry scroll-down clips at top edge" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    s.nextSlice(@embedFile("res/tmux_wheel_split_attach.raw"));
+
+    // Play the whole scroll-up half first (no selection yet), leaving the
+    // view 30 lines back: LINE-448 on row 0.
+    const capture: []const u8 = @embedFile("res/tmux_wheel_split_scroll.raw");
+    const first_dl = std.mem.indexOf(u8, capture, "\x1b[1M").?;
+    const up_end = std.mem.lastIndexOf(
+        u8,
+        capture[0..first_dl],
+        "\x1b[?25h",
+    ).? + "\x1b[?25h".len;
+    s.nextSlice(capture[0..up_end]);
+
+    // Now select near the TOP and replay the scroll-down half: content
+    // moves up via DLs, so the selection walks out the top edge and must
+    // clip there row by row (and never revive after it is gone - the
+    // stream ends with copy-mode auto-exit's full repaint).
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 2 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 7, .y = 4 } }).?,
+        false,
+    ));
+    {
+        const str = try screen.selectionString(alloc, .{
+            .sel = screen.selection.?,
+        });
+        defer alloc.free(str);
+        try testing.expectEqualStrings("LINE-450\nLINE-451\nLINE-452", str);
+    }
+
+    const saw_partial = try replayExpectContiguousRuns(
+        &s,
+        &t,
+        capture[up_end..],
+        &.{ "LINE-450", "LINE-451", "LINE-452" },
+    );
+
+    try testing.expect(saw_partial);
+    try testing.expect(screen.selection == null);
+}
