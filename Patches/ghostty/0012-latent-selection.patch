+/// Free and forget the latent selection, if any.
+pub fn dropLatentSelection(self: *Screen) void {
+    if (self.latent_selection) |lat| self.alloc.free(lat.text);
+    self.latent_selection = null;
+}
+
+/// Demote the live selection to a latent one because rows it covers are
+/// about to be destroyed by an in-place scroll region shift moving the
+/// region content by `delta` rows. Both endpoints must lie on active rows
+/// within [top, bottom]; selections reaching into history or outside the
+/// scroll region move differently from the region content and are cleared
+/// outright. Always clears the live selection.
+pub fn demoteSelectionToLatent(
+    self: *Screen,
+    delta: isize,
+    top: usize,
+    bottom: usize,
+) void {
+    defer self.clearSelection();
+    const sel = if (self.selection) |*v| v else return;
+    const sp = sel.start();
+    const ep = sel.end();
+    const spt = self.pages.pointFromPin(.active, sp) orelse return;
+    const ept = self.pages.pointFromPin(.active, ep) orelse return;
+    const sy: usize = @intCast(spt.coord().y);
+    const ey: usize = @intCast(ept.coord().y);
+    if (sy < top or sy > bottom or ey < top or ey > bottom) return;
+    const text = self.selectionString(self.alloc, .{
+        .sel = sel.*,
+        .trim = false,
+    }) catch return;
+    self.dropLatentSelection();
+    self.latent_selection = .{
+        .start_x = sp.x,
+        .start_y = @as(isize, @intCast(sy)) + delta,
+        .end_x = ep.x,
+        .end_y = @as(isize, @intCast(ey)) + delta,
+        .rectangle = sel.rectangle,
+        .text = text,
+    };
+}
+
+/// Attempt to restore a latent selection: only once both endpoints lie on
+/// visible rows and the content there is byte-identical to the captured
+/// text. Cheap no-op when no latent selection exists, so this is safe to
+/// call from hot-ish paths (cursor addressing) - a tmux-style repaint of
+/// the returning rows always ends with cursor movement, which is what
+/// triggers the successful restore.
+///
+/// When the ledger-tracked coordinates do not match, fall back to a
+/// bounded full-viewport content scan: the IL/DL ledger cannot see motion
+/// a multiplexer performs via in-place repaints (large scroll jumps,
+/// copy-mode exit overshoot), but the content itself is ground truth.
+pub fn attemptRestoreLatent(self: *Screen) void {
+    const lat = self.latent_selection orelse return;
+
+    // A live (user-made) selection supersedes the latent one.
+    if (self.selection != null) {
+        self.dropLatentSelection();
+        return;
+    }
+
+    const rows: isize = @intCast(self.pages.rows);
+    if (lat.start_y >= 0 and lat.start_y < rows and
+        lat.end_y >= 0 and lat.end_y < rows)
+    {
+        // Bound the total work an unmatchable latent selection can cost.
+        self.latent_selection.?.attempts += 1;
+        if (self.latent_selection.?.attempts > latent_max_attempts) {
+            self.dropLatentSelection();
+            return;
+        }
+
+        if (self.latentTextMatchesAt(lat, lat.start_y, lat.end_y)) {
+            _ = self.restoreLatentAt(lat.start_y, lat.end_y);
+            return;
+        }
+    }
+
+    // Tracked coordinates are wrong or out of view: recover by content.
+    // The scan cap doubles as garbage collection for forgotten latents.
+    self.latent_selection.?.scans += 1;
+    if (self.latent_selection.?.scans > latent_max_scans) {
+        self.dropLatentSelection();
+        return;
+    }
+    _ = self.latentRescan();
+}
+
+/// True if the latent selection's text appears exactly at the given
+/// active-row coordinates (columns from the latent geometry).
+fn latentTextMatchesAt(self: *Screen, lat: LatentSelection, sy: isize, ey: isize) bool {
+    const start_pin = self.pages.pin(.{ .active = .{
+        .x = lat.start_x,
+        .y = @intCast(sy),
+    } }) orelse return false;
+    const end_pin = self.pages.pin(.{ .active = .{
+        .x = lat.end_x,
+        .y = @intCast(ey),
+    } }) orelse return false;
+    const sel = Selection.init(start_pin, end_pin, lat.rectangle);
+    const text = self.selectionString(self.alloc, .{
+        .sel = sel,
+        .trim = false,
+    }) catch return false;
+    defer self.alloc.free(text);
+    return std.mem.eql(u8, text, lat.text);
+}
+
+/// Re-create the real selection at the given coordinates and retire the
+/// latent state. select() drops the latent record.
+fn restoreLatentAt(self: *Screen, sy: isize, ey: isize) bool {
+    const lat = self.latent_selection orelse return false;
+    const start_pin = self.pages.pin(.{ .active = .{
+        .x = lat.start_x,
+        .y = @intCast(sy),
+    } }) orelse return false;
+    const end_pin = self.pages.pin(.{ .active = .{
+        .x = lat.end_x,
+        .y = @intCast(ey),
+    } }) orelse return false;
+    const sel = Selection.init(start_pin, end_pin, lat.rectangle);
+    self.select(sel) catch return false;
+    return true;
+}
+
+/// Scan every vertical placement of the latent geometry that fits in the
+/// viewport for an exact text match; the placement nearest the tracked
+/// position wins. Returns true when a restore happened.
+fn latentRescan(self: *Screen) bool {
+    const lat = self.latent_selection orelse return false;
+    const rows: isize = @intCast(self.pages.rows);
+    const dy = lat.end_y - lat.start_y;
+    const h: isize = @intCast(@abs(dy));
+    if (h >= rows) return false;
+
+    var best: ?isize = null;
+    var base: isize = 0;
+    while (base + h < rows) : (base += 1) {
+        const sy = if (dy >= 0) base else base + h;
+        const ey = sy + dy;
+        if (self.latentTextMatchesAt(lat, sy, ey)) {
+            if (best) |b| {
+                if (@abs(sy - lat.start_y) < @abs(b - lat.start_y)) best = sy;
+            } else best = sy;
+        }
+    }
+    const sy = best orelse return false;
+    return self.restoreLatentAt(sy, sy + dy);
+}
+
 pub const SelectionString = struct {
     /// The selection to convert to a string.
     sel: Selection,
@@ -10944,3 +11111,34 @@ test "Screen: promptClickMove click right of input cursor on last char" {
     try testing.expectEqual(@as(usize, 1), result.right);
     try testing.expectEqual(@as(usize, 0), result.left);
 }
+
+pub const LatentSelection = struct {
+    /// Endpoint coordinates in active-area space. The rows may lie outside
+    /// [0, rows) while the content is scrolled away; they are translated by
+    /// every subsequent region shift.
+    start_x: size.CellCountInt,
+    start_y: isize,
+    end_x: size.CellCountInt,
+    end_y: isize,
+    rectangle: bool,
+    /// Exact text of the original selection (selectionString, untrimmed),
+    /// owned by Screen.alloc. Restoration requires the content at the
+    /// translated coordinates to match byte-for-byte, so stale latent
+    /// state can never highlight the wrong content.
+    text: [:0]const u8,
+    /// In-view restore attempts so far; bounded so a never-matching latent
+    /// selection cannot cost extraction work forever.
+    attempts: usize = 0,
+    /// Full-viewport content rescans so far. Rescans recover from motion
+    /// the IL/DL ledger cannot see (multiplexers repaint in place on large
+    /// jumps); the cap doubles as garbage collection - sustained screen
+    /// activity without a match means the user moved on.
+    scans: usize = 0,
+};
+
+/// Attempts allowed while the latent geometry is fully in view before the
+/// latent selection is dropped as unmatchable.
+const latent_max_attempts = 4096;
+
+/// Viewport content rescans allowed before the latent selection is dropped.
+const latent_max_scans = 512;
