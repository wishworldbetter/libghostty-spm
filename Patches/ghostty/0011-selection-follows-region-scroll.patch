+
+test "Terminal: deleteLines translates selection up (in-place region scroll)" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    try t.printString("AAA");
+    t.carriageReturn();
+    try t.linefeed();
+    try t.printString("BBB");
+    t.carriageReturn();
+    try t.linefeed();
+    try t.printString("CCC");
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 1 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 1 } }).?,
+        false,
+    ));
+
+    t.setCursorPos(1, 1);
+    t.deleteLines(1);
+
+    const sel = screen.selection.?;
+    try testing.expectEqual(
+        point.Point{ .active = .{ .x = 0, .y = 0 } },
+        screen.pages.pointFromPin(.active, sel.start()).?,
+    );
+    const str = try screen.selectionString(alloc, .{ .sel = sel });
+    defer alloc.free(str);
+    try testing.expectEqualStrings("BBB", str);
+}
