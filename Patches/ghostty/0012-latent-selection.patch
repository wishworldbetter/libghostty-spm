+
+/// Free and forget the latent selection, if any.
+pub fn dropLatentSelection(self: *Screen) void {
+    if (self.latent_selection) |lat| self.alloc.free(lat.text);
+    self.latent_selection = null;
+}
+
+/// Demote the live selection to a latent one because rows it covers are
+/// about to be destroyed by an in-place scroll region shift moving the
+/// region content by `delta` rows. Both endpoints must lie on active rows
+/// within [top, bottom]; selections reaching into history or outside the
+/// scroll region move differently from the region content and are cleared
+/// outright. Always clears the live selection.
+pub fn demoteSelectionToLatent(
+    self: *Screen,
+    delta: isize,
+    top: usize,
+    bottom: usize,
+) void {
+    defer self.clearSelection();
+
+    // A shadow snapshot (taken at the last paint boundary, before any
+    // in-place repaints could overwrite the rows) is the authoritative
+    // record of what the user selected - the live pins may already
+    // cover repainted content. Promote it in place: its geometry has
+    // been translated by every shift alongside the pins, including the
+    // one currently in progress.
+    if (self.latent_selection) |*lat| {
+        if (lat.shadow) {
+            lat.shadow = false;
+            return;
+        }
+    }
+
+    const sel = if (self.selection) |*v| v else return;
+    const sp = sel.start();
+    const ep = sel.end();
+    const spt = self.pages.pointFromPin(.active, sp) orelse return;
+    const ept = self.pages.pointFromPin(.active, ep) orelse return;
+    const sy: usize = @intCast(spt.coord().y);
+    const ey: usize = @intCast(ept.coord().y);
+    if (sy < top or sy > bottom or ey < top or ey > bottom) return;
+    const text = self.selectionString(self.alloc, .{
+        .sel = sel.*,
+        .trim = false,
+    }) catch return;
+    self.dropLatentSelection();
+    self.latent_selection = .{
+        .start_x = sp.x,
+        .start_y = @as(isize, @intCast(sy)) + delta,
+        .end_x = ep.x,
+        .end_y = @as(isize, @intCast(ey)) + delta,
+        .rectangle = sel.rectangle,
+        .text = text,
+    };
+}
+
+/// Attempt to restore a latent selection at its ledger-tracked
+/// coordinates: only once both endpoints lie on visible rows and the
+/// content there is byte-identical to the captured text. Cheap no-op when
+/// no latent selection exists (single null check), and free while the
+/// coordinates are out of view, so this is safe to call from hot-ish
+/// paths (cursor addressing, region-shift entry).
+///
+/// This is deliberately coordinate-only. These triggers fire *mid-paint*
+/// (tmux addresses a row with CUP before printing it), so a content
+/// rescan here would mostly see half-painted frames - and, captured from
+/// real tmux, a fast wheel flick fires thousands of such triggers, which
+/// is how v2.1 burned its entire rescan budget before the content ever
+/// returned. Content rescans now happen only at paint boundaries; see
+/// latentPaintSettled.
+pub fn attemptRestoreLatent(self: *Screen) void {
+    const lat = self.latent_selection orelse return;
+
+    // A shadow record coexists with the live selection it mirrors and
+    // acts only at paint boundaries.
+    if (lat.shadow) return;
+
+    // A live (user-made) selection supersedes the latent one.
+    if (self.selection != null) {
+        self.dropLatentSelection();
+        return;
+    }
+
+    const rows: isize = @intCast(self.pages.rows);
+    if (lat.start_y < 0 or lat.start_y >= rows or
+        lat.end_y < 0 or lat.end_y >= rows) return;
+
+    // Bound the total work an unmatchable latent selection can cost.
+    self.latent_selection.?.attempts += 1;
+    if (self.latent_selection.?.attempts > latent_max_attempts) {
+        self.dropLatentSelection();
+        return;
+    }
+
+    if (self.latentTextMatchesAt(lat, lat.start_y, lat.end_y)) {
+        _ = self.restoreLatentAt(lat.start_y, lat.end_y);
+    }
+}
+
+/// A paint frame is starting (the emitter hid the cursor - tmux brackets
+/// every repaint with DECRST/DECSET 25). Snapshot the live selection at
+/// this instant: if the upcoming frame moves content by repainting rows
+/// in place (copy-mode entry, coalesced scroll frames - captured from
+/// real tmux, a fast flick moves most of its distance this way, with no
+/// IL/DL at all), this pre-paint snapshot is the only surviving record
+/// of what the user actually selected. Near-zero cost when no live
+/// selection exists.
+pub fn latentPaintBegins(self: *Screen) void {
+    const sel = if (self.selection) |*v| v else return;
+
+    // An existing record - shadow or real latent - is older truth than
+    // whatever is on the grid now; never overwrite it here.
+    if (self.latent_selection != null) return;
+
+    // Only selections fully on active rows can be tracked through
+    // region repaints (same constraint as demoteSelectionToLatent).
+    const sp = sel.start();
+    const ep = sel.end();
+    const spt = self.pages.pointFromPin(.active, sp) orelse return;
+    const ept = self.pages.pointFromPin(.active, ep) orelse return;
+    const text = self.selectionString(self.alloc, .{
+        .sel = sel.*,
+        .trim = false,
+    }) catch return;
+    self.latent_selection = .{
+        .start_x = sp.x,
+        .start_y = @intCast(spt.coord().y),
+        .end_x = ep.x,
+        .end_y = @intCast(ept.coord().y),
+        .rectangle = sel.rectangle,
+        .text = text,
+        .shadow = true,
+    };
+}
+
+/// A paint frame completed (the emitter made the cursor visible again).
+/// This is the only trigger that ever sees the settled screen: captured
+/// from real tmux, the final repaint of a scroll-back is followed by
+/// nothing but DECSET 25 - no cursor addressing, no IL/DL - so without
+/// this hook a latent selection whose content just returned would wait
+/// forever. Near-zero cost when no latent state exists.
+pub fn latentPaintSettled(self: *Screen) void {
+    const lat = self.latent_selection orelse return;
+
+    if (lat.shadow) {
+        const sel = if (self.selection) |*v| v else {
+            // The live selection vanished without going through
+            // demotion; keep its snapshot as a real latent record.
+            self.latent_selection.?.shadow = false;
+            return;
+        };
+
+        // Sticky rule: while the content under the live selection is
+        // still byte-identical to the snapshot, settling NEVER moves
+        // it - even if identical text also exists elsewhere on screen
+        // (two `ll` runs of the same directory). Staying put is the
+        // only correct adjudication for duplicated content.
+        const cur = self.selectionString(self.alloc, .{
+            .sel = sel.*,
+            .trim = false,
+        }) catch return;
+        defer self.alloc.free(cur);
+        if (std.mem.eql(u8, cur, lat.text)) {
+            self.dropLatentSelection();
+            return;
+        }
+
+        // The frame moved content out from under the live selection.
+        // If the exact text is elsewhere in the viewport, re-anchor the
+        // highlight to it (latentRescan restores via select(), which
+        // replaces the live selection and retires the record). The
+        // candidate nearest the CURRENT pin position wins: the highlight
+        // moves as little as possible, which keeps it tracking its own
+        // copy when byte-identical copies exist. If the text is not in
+        // view - scrolled beyond the screen, or overwritten for good -
+        // keep the live selection as upstream would, and keep the
+        // shadow: the text may scroll back later. The pins are no
+        // longer known to be glued to the content though, so the
+        // geometry is marked broken. The scan cap garbage-collects a
+        // shadow that never matches again.
+        const origin: isize = origin: {
+            const spt = self.pages.pointFromPin(.active, sel.start()) orelse
+                break :origin lat.start_y;
+            break :origin @intCast(spt.coord().y);
+        };
+        self.latent_selection.?.shadow = false;
+        if (self.latentRescan(origin)) return;
+        self.latent_selection.?.shadow = true;
+        self.latent_selection.?.ledger_broken = true;
+        self.latent_selection.?.scans += 1;
+        if (self.latent_selection.?.scans > latent_max_scans)
+            self.dropLatentSelection();
+        return;
+    }
+
+    // No live selection: coordinate attempt first - the IL/DL ledger is
+    // exact when tmux scrolls incrementally, and with byte-identical
+    // copies on screen it is the only provenance we have.
+    const rows: isize = @intCast(self.pages.rows);
+    const in_view = lat.start_y >= 0 and lat.start_y < rows and
+        lat.end_y >= 0 and lat.end_y < rows;
+    if (in_view and self.latentTextMatchesAt(lat, lat.start_y, lat.end_y)) {
+        _ = self.restoreLatentAt(lat.start_y, lat.end_y);
+        return;
+    }
+
+    // While the ledger is still traced (every motion since demotion was
+    // IL/DL-translated) and it says the content is out of view, believe
+    // it: the content has not arrived yet, and a content rescan now
+    // could only ever grab a byte-identical copy that happens to be
+    // visible - the exact "highlight jumps to the other `ll` output"
+    // failure. Hold until the ledger position scrolls in, or until an
+    // in-place rewrite breaks the trace. Held frames cost nothing and
+    // are not charged against any budget.
+    if (!in_view and !lat.ledger_broken) return;
+
+    // Ledger wrong (in view but mismatched) or broken: content is the
+    // only ground truth left; rescan, nearest to the ledger coordinate.
+    // One rescan per completed frame is bounded work; the cap doubles as
+    // garbage collection for a latent selection that never matches
+    // again.
+    self.latent_selection.?.scans += 1;
+    if (self.latent_selection.?.scans > latent_max_scans) {
+        self.dropLatentSelection();
+        return;
+    }
+    _ = self.latentRescan(lat.start_y);
+}
+
+/// True if the latent selection's text appears exactly at the given
+/// active-row coordinates (columns from the latent geometry).
+fn latentTextMatchesAt(self: *Screen, lat: LatentSelection, sy: isize, ey: isize) bool {
+    const start_pin = self.pages.pin(.{ .active = .{
+        .x = lat.start_x,
+        .y = @intCast(sy),
+    } }) orelse return false;
+    const end_pin = self.pages.pin(.{ .active = .{
+        .x = lat.end_x,
+        .y = @intCast(ey),
+    } }) orelse return false;
+    const sel = Selection.init(start_pin, end_pin, lat.rectangle);
+    const text = self.selectionString(self.alloc, .{
+        .sel = sel,
+        .trim = false,
+    }) catch return false;
+    defer self.alloc.free(text);
+    return std.mem.eql(u8, text, lat.text);
+}
+
+/// Re-create the real selection at the given coordinates and retire the
+/// latent state. select() drops the latent record.
+fn restoreLatentAt(self: *Screen, sy: isize, ey: isize) bool {
+    const lat = self.latent_selection orelse return false;
+    const start_pin = self.pages.pin(.{ .active = .{
+        .x = lat.start_x,
+        .y = @intCast(sy),
+    } }) orelse return false;
+    const end_pin = self.pages.pin(.{ .active = .{
+        .x = lat.end_x,
+        .y = @intCast(ey),
+    } }) orelse return false;
+    const sel = Selection.init(start_pin, end_pin, lat.rectangle);
+    self.select(sel) catch return false;
+    return true;
+}
+
+/// Scan every vertical placement of the latent geometry that fits in the
+/// viewport for an exact text match; the placement nearest `origin_y`
+/// wins. The origin is the current pin position when re-anchoring a live
+/// selection (minimize how far the highlight moves - with byte-identical
+/// copies on screen this is what keeps it tracking its own copy) and the
+/// ledger coordinate when reviving a demoted one. Distance ties resolve
+/// deterministically to the topmost placement (the scan ascends and only
+/// a strictly closer candidate replaces the current best), so repeated
+/// scans of an unchanged screen can never alternate between two equally
+/// distant copies. Returns true when a restore happened.
+fn latentRescan(self: *Screen, origin_y: isize) bool {
+    const lat = self.latent_selection orelse return false;
+    const rows: isize = @intCast(self.pages.rows);
+    const dy = lat.end_y - lat.start_y;
+    const h: isize = @intCast(@abs(dy));
+    if (h >= rows) return false;
+
+    var best: ?isize = null;
+    var base: isize = 0;
+    while (base + h < rows) : (base += 1) {
+        const sy = if (dy >= 0) base else base + h;
+        const ey = sy + dy;
+        if (self.latentTextMatchesAt(lat, sy, ey)) {
+            if (best) |b| {
+                if (@abs(sy - origin_y) < @abs(b - origin_y)) best = sy;
+            } else best = sy;
+        }
+    }
+    const sy = best orelse return false;
+    return self.restoreLatentAt(sy, sy + dy);
 }
 
