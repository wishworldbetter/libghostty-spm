+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 2 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 2 } }).?,
+        false,
+    ));
+
+    // Push the selection out: latent now tracks y=5 (off-screen).
+    t.setCursorPos(1, 1);
+    t.insertLines(3);
+    try testing.expect(screen.latent_selection != null);
