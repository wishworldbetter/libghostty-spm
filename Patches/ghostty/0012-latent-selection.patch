+    defer t.deinit(alloc);
+
+    // Two byte-identical "AAA"/"BBB" blocks (rows 3-4 and rows 9-10),
+    // unique rows elsewhere - the `ll`-twice shape.
+    const P = struct {
+        const content = [_][]const u8{
+            "R00", "R01", "R02", "AAA", "BBB", "R05", "R06",
+            "R07", "R08", "AAA", "BBB", "R11", "R12", "R13",
+        };
+        fn paint(term: *Terminal, offset: usize) !void {
+            for (0..12) |r| {
+                term.setCursorPos(r + 1, 1);
+                try term.printString(content[r + offset]);
+            }
+        }
+    };
+    try P.paint(&t, 0);
+
+    // Select the SECOND copy's "AAA" (row 9).
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 9 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 9 } }).?,
+        false,
+    ));
+
+    const rowOf = struct {
+        fn f(scr: *Screen) !u32 {
+            const sel = scr.selection orelse return error.NoSelection;
+            const pt = scr.pages.pointFromPin(.active, sel.start()) orelse
+                return error.NotActive;
+            return pt.coord().y;
+        }
+    }.f;
+
+    // Frame 1: in-place repaint scrolls everything up by one. The
+    // second copy's "AAA" moves 9 -> 8; the first copy's identical
+    // "AAA" sits at row 2. Re-anchoring must take the candidate nearest
+    // the current pins - follow its own copy, never jump blocks.
+    t.cursorVisibilityChanged(false);
+    try P.paint(&t, 1);
+    t.cursorVisibilityChanged(true);
+    try testing.expectEqual(@as(u32, 8), try rowOf(screen));
+
+    // Frame 2: one more row up: 8 -> 7 (first copy now at row 1).
+    t.cursorVisibilityChanged(false);
+    try P.paint(&t, 2);
+    t.cursorVisibilityChanged(true);
+    try testing.expectEqual(@as(u32, 7), try rowOf(screen));
+
+    // Frame 3: no motion - repaint the identical content. The sticky
+    // rule: a still-matching selection is NEVER moved, even though a
+    // byte-identical copy exists elsewhere on screen.
+    t.cursorVisibilityChanged(false);
+    try P.paint(&t, 2);
+    t.cursorVisibilityChanged(true);
+    try testing.expectEqual(@as(u32, 7), try rowOf(screen));
