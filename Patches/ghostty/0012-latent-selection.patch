+pub const LatentSelection = struct {
+    /// Endpoint coordinates in active-area space. The rows may lie outside
+    /// [0, rows) while the content is scrolled away; they are translated by
+    /// every subsequent region shift.
+    start_x: size.CellCountInt,
+    start_y: isize,
+    end_x: size.CellCountInt,
+    end_y: isize,
+    rectangle: bool,
+    /// Exact text of the original selection (selectionString, untrimmed),
+    /// owned by Screen.alloc. Restoration requires the content at the
+    /// translated coordinates to match byte-for-byte, so stale latent
+    /// state can never highlight the wrong content.
+    text: [:0]const u8,
+    /// In-view restore attempts so far; bounded so a never-matching latent
+    /// selection cannot cost extraction work forever.
+    attempts: usize = 0,
+    /// Completed paint frames that ran a full-viewport content rescan
+    /// without a match. Rescans recover from motion the IL/DL ledger
+    /// cannot see (multiplexers repaint in place on large jumps) and are
+    /// charged only once per settled frame - never from the mid-paint
+    /// CUP/IL/DL triggers, which fire thousands of times during a single
+    /// wheel flick. The cap doubles as garbage collection - sustained
+    /// screen activity without a match means the user moved on.
+    scans: usize = 0,
+    /// A shadow record mirrors a live selection that still exists: it is
+    /// the pre-paint snapshot taken when the emitter hid the cursor to
+    /// start a frame (latentPaintBegins). In-place repaints overwrite
+    /// selected rows without any hook firing, so by demotion time the
+    /// pins may cover repainted content - the shadow preserves the text
+    /// the user actually selected. It is resolved at frame completion
+    /// (latentPaintSettled): dropped when the live selection still
+    /// matches, used to re-anchor when the content moved within view,
+    /// promoted to a real latent record on demotion.
+    shadow: bool = false,
+    /// True once the geometry can no longer be trusted to rule out the
+    /// content being elsewhere: an in-place row rewrite (EL/ED) happened
+    /// while this record existed, or a paint frame moved the mirrored
+    /// live selection somewhere the shadow could not follow. While the
+    /// ledger is still traced (false), an out-of-view coordinate means
+    /// "the content has not arrived yet" and content rescans are held
+    /// off - this is what keeps a restore from grabbing a byte-identical
+    /// copy of the selection (two `ll` runs of the same directory) that
+    /// scrolls into view before the original does.
+    ledger_broken: bool = false,
+};
+
+/// Attempts allowed while the latent geometry is fully in view before the
+/// latent selection is dropped as unmatchable.
+const latent_max_attempts = 4096;
+
+/// Viewport content rescans allowed before the latent selection is dropped.
+const latent_max_scans = 512;
