+
+test "Terminal: latent selection restores after scroll away and back" {
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t = try init(alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    for ("ABCDE", 0..) |c, i| {
+        t.setCursorPos(i + 1, 1);
+        try t.printString(&.{ c, c, c });
+    }
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 2 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 2, .y = 2 } }).?,
+        false,
+    ));
+
+    // Scroll region content down by 3: "CCC"'s row is pushed out and
+    // destroyed, so the selection is demoted to latent.
+    t.setCursorPos(1, 1);
+    t.insertLines(3);
+    try testing.expect(screen.selection == null);
+    try testing.expect(screen.latent_selection != null);
+
+    // Scroll back up by 3, then repaint the returning row the way tmux
+    // does: address it with CUP and print the same content.
+    t.deleteLines(3);
+    t.setCursorPos(3, 1);
+    try t.printString("CCC");
+    // The repaint's final cursor movement triggers the restore.
+    t.setCursorPos(1, 1);
+
+    const sel = screen.selection orelse return error.TestExpectedRestore;
+    try testing.expect(screen.latent_selection == null);
+    try testing.expectEqual(
+        point.Point{ .active = .{ .x = 0, .y = 2 } },
+        screen.pages.pointFromPin(.active, sel.start()).?,
+    );
+    const str = try screen.selectionString(alloc, .{ .sel = sel });
+    defer alloc.free(str);
+    try testing.expectEqualStrings("CCC", str);
+}
