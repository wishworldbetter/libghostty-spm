+test "Terminal: real tmux coalesced-entry scroll never shows a stale highlight" {
+    // The legacy command shape (`copy-mode -e ; send-keys -X -N 5
+    // scroll-up` in ONE invocation) makes tmux emit an entry repaint that
+    // already carries the first tick's shift - in-place, no IL/DL. The
+    // ledger cannot track that; the frame-boundary content check must
+    // drop the selection instead of leaving it on the wrong text.
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    // Attach: LINE-478..LINE-500 on rows 0..22, prompt on row 23.
+    s.nextSlice(@embedFile("res/tmux_wheel_slow_attach.raw"));
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 12 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 7, .y = 12 } }).?,
+        false,
+    ));
+
+    _ = try replayExpectContiguousRuns(
+        &s,
+        &t,
+        @embedFile("res/tmux_wheel_slow_scroll.raw"),
+        &.{"LINE-490"},
+    );
+    try testing.expect(screen.selection == null);
+}
+
+test "Terminal: real tmux flick with identical blocks never lands on the other copy" {
+    // Two byte-identical 9-row blocks on screen; select DUP-05 in the
+    // SECOND block, wheel out ~66 lines and back. v2.1-v3.1's content
+    // rescan could revive the highlight on the FIRST block's copy; v4 has
+    // no rescan at all - the frame checks only ever compare the covered
+    // text, so the worst case is a clean drop, never a jump.
+    const Selection = @import("Selection.zig");
+    const alloc = testing.allocator;
+    var t: Terminal = try .init(alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+
+    var s: Stream = .initAlloc(alloc, .init(&t));
+    defer s.deinit();
+
+    s.nextSlice(@embedFile("res/tmux_wheel_dup_attach.raw"));
+
+    const screen = t.screens.active;
+    try screen.select(Selection.init(
+        screen.pages.pin(.{ .active = .{ .x = 0, .y = 18 } }).?,
+        screen.pages.pin(.{ .active = .{ .x = 5, .y = 18 } }).?,
+        false,
+    ));
+
+    _ = try replayExpectContiguousRuns(
+        &s,
+        &t,
+        @embedFile("res/tmux_wheel_dup_scroll.raw"),
+        &.{"DUP-05"},
+    );
+    try testing.expect(screen.selection == null);
+}
