 // a single shared helper function, probably on `Screen` not here.
 // I'm just too lazy to do that rn :p
 
+/// Translate the active screen's selection so it keeps covering the same
+/// content when insertLines/deleteLines shift rows vertically within the
+/// scroll region (scrollUp/scrollDown and CSI S/T route through those, so
+/// this covers them too).
+///
+/// The region shift moves cell contents between fixed row slots, so tracked
+/// pins - which anchor to a row slot - keep pointing at the old location
+/// while the content moves away. True scrolling (page list movement) already
+/// translates tracked pins; this brings in-place region scrolling to parity
+/// for the selection specifically.
+///
+/// Must be called while the cursor is still at the top of the affected range
+/// (both insertLines and deleteLines operate on rows
+/// [cursor.y, scrolling_region.bottom]) and before any rows are moved.
+///
+/// delta is the number of rows the region content moves: positive is down
+/// (insertLines), negative is up (deleteLines). A selection endpoint whose
+/// row content is destroyed by the shift clears the whole selection.
+fn shiftSelectionForRegionScroll(self: *Terminal, delta: isize) void {
+    const screen = self.screens.active;
+    const sel = if (screen.selection) |*v| v else return;
+
+    const top: usize = screen.cursor.y;
+    const bottom: usize = self.scrolling_region.bottom;
+
+    // With left/right margins only a horizontal slice of each row moves.
+    // A selection can't follow a partial-row move, so clear it if it
+    // touches the affected rows at all.
+    const left_right = self.scrolling_region.left > 0 or
+        self.scrolling_region.right < self.cols - 1;
+
+    const pins = [2]*PageList.Pin{ sel.startPtr(), sel.endPtr() };
+    var moved: [2]?PageList.Pin = .{ null, null };
+    for (pins, 0..) |p, i| {
+        // Pins outside the active area (history) never move: the region
+        // shift only rewrites active rows.
+        const pt = screen.pages.pointFromPin(.active, p.*) orelse continue;
+        const y: usize = @intCast(pt.coord().y);
+        if (y < top or y > bottom) continue;
+        if (left_right) return screen.clearSelection();
+        if (delta > 0) {
+            const d: usize = @intCast(delta);
+            // Content originally in the bottom d rows of the range is lost.
+            if (y + d > bottom) return screen.clearSelection();
+            moved[i] = p.down(d).?;
+        } else {
+            const d: usize = @intCast(-delta);
+            // Content originally in the top d rows of the range is lost.
+            if (y < top + d) return screen.clearSelection();
+            moved[i] = p.up(d).?;
+        }
+    }
+
+    for (pins, moved) |p, m| {
+        const new_pin = m orelse continue;
+        p.* = new_pin;
+        screen.dirty.selection = true;
+    }
+}
